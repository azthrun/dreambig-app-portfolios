---
import { Image } from 'astro:assets';
import dreambigMark from '../assets/dreambig-mark.png';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-4 px-gutter py-8 text-sm text-muted">
    <p>© {year} Terry Chen</p>
    <p class="flex items-center gap-2">
      <Image src={dreambigMark} alt="" width={20} height={20} class="size-5" />
      <span>DreamBig</span>
    </p>
  </div>
</footer>
